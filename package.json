    "test": "node scripts/test.mjs",
    "install": "node scripts/install.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
